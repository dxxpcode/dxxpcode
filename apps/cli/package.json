{
  "name": "dxxpcode",
  "version": "0.1.0",
  "type": "module",
  "description": "DxxpCode — a terminal-native AI coding agent",
  "license": "Apache-2.0",
  "bin": {
    "dxxpcode": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --conditions=development src/cli.ts",
    "dev": "NODE_OPTIONS=--conditions=development tsx src/cli.ts"
  },
  "dependencies": {
    "@dxxpcode/agent": "^0.1.0",
    "@dxxpcode/permissions": "^0.1.0",
    "@dxxpcode/project": "^0.1.0",
    "@dxxpcode/providers": "^0.1.0",
    "@dxxpcode/sessions": "^0.1.0",
    "@dxxpcode/tools": "^0.1.0",
    "ink": "^5.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
