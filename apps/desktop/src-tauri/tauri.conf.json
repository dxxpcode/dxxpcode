{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dxxpcode-desktop",
  "version": "0.2.3",
  "identifier": "dev.dxxpcode.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "dxxpcode",
        "width": 1000,
        "height": 700,
        "decorations": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "app",
      "dmg",
      "msi",
      "nsis"
    ],
    "externalBin": [
      "binaries/dxxpcode"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1Mzk4MTM4MzY4OTcxRTMKUldUamNZazJPSUU1bFdzMHNJeVdWWG91OEJkSmtHNHdpNjR1VWtkS1NCbmNkUFptNUpiSkRLUXIK",
      "endpoints": [
        "https://github.com/dxxpcode/DxxpCode-Terminal/releases/latest/download/latest.json"
      ]
    }
  }
}
