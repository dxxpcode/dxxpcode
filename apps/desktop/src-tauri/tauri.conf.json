{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dxxpcode-desktop",
  "version": "0.2.0",
  "identifier": "dev.dxxpcode.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "windows": [
      {
        "title": "dxxpcode",
        "width": 1000,
        "height": 700
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage",
      "dmg",
      "msi",
      "nsis"
    ],
    "externalBin": [
      "binaries/dxxpcode"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
