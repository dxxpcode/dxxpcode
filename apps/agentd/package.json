{
  "name": "dxxpcode-agent",
  "version": "0.1.0",
  "type": "module",
  "description": "DxxpCode headless agent — JSON-RPC bridge binary embedded by the macOS app",
  "license": "Apache-2.0",
  "bin": {
    "dxxpcode-agent": "./dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --conditions=development src/main.ts"
  },
  "dependencies": {
    "@dxxpcode/bridge": "^0.1.0",
    "@dxxpcode/providers": "^0.1.0",
    "@dxxpcode/sessions": "^0.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/thenextdeveloper/DxxpCode-Terminal.git",
    "directory": "apps/agentd"
  }
}
